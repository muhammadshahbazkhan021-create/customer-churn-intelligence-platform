# Application Settings
PROJECT_NAME="Customer Churn Intelligence Platform"
DEBUG=False
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Model Artifact Locations (Relative to Repository Root)
MODEL_PATH="artifacts/models/best_model.joblib"
PREPROCESSOR_PATH="artifacts/preprocessors/preprocessor.joblib"
METRICS_PATH="artifacts/metrics/evaluation_metrics.json"

# Inference Decision Boundary
DEFAULT_THRESHOLD=0.42

# Database Configuration (SQLite default, or postgresql://user:pass@localhost:5432/churn_db)
DATABASE_URL="sqlite:///./data/churn_intelligence.db"

# Frontend Integration
API_URL="http://127.0.0.1:8000/api/v1"